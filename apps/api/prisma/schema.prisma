generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Area {
  ENGINEERING
  UNIVERSITY
  CAREER
  PRODUCT
  DISTRIBUTION
  PERSONAL

  @@map("area")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ARCHIVED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH

  @@map("task_priority")
}

enum RoutineSchedule {
  DAILY
  WEEKDAYS
  CUSTOM

  @@map("routine_schedule")
}

enum NorthTrackStatus {
  ACTIVE
  PAUSED
  COMPLETED

  @@map("north_track_status")
}

enum NorthItemStatus {
  TODO
  IN_PROGRESS
  COMPLETED

  @@map("north_item_status")
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId     String?        @unique @map("auth_user_id") @db.Uuid
  googleId       String?        @unique @map("google_id")
  email          String         @unique
  displayName    String         @map("display_name")
  avatarUrl      String?        @map("avatar_url")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  tasks          Task[]
  routines       Routine[]
  links          Link[]
  timeEntries    TimeEntry[]
  routineEntries RoutineEntry[]
  northTracks    NorthTrack[]

  @@map("users")
}

model Task {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  title            String
  description      String?
  area             Area
  status           TaskStatus   @default(PENDING)
  priority         TaskPriority @default(MEDIUM)
  estimatedMinutes Int?         @map("estimated_minutes")
  actualMinutes    Int?         @map("actual_minutes")
  dueDate          DateTime?    @map("due_date") @db.Date
  plannedFor       DateTime?    @map("planned_for") @db.Date
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries      TimeEntry[]

  @@index([userId, status], map: "tasks_user_status_idx")
  @@index([userId, dueDate], map: "tasks_user_due_date_idx")
  @@index([userId, plannedFor], map: "tasks_user_planned_for_idx")
  @@map("tasks")
}

model Routine {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  title       String
  description String?
  area        Area?
  schedule    RoutineSchedule @default(DAILY)
  daysOfWeek  Int[]           @default([]) @map("days_of_week")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     RoutineEntry[]

  @@index([userId], map: "routines_user_id_idx")
  @@map("routines")
}

model RoutineEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routineId   String    @map("routine_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  date        DateTime  @default(now()) @db.Date
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  routine     Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@index([userId, date], map: "routine_entries_user_date_idx")
  @@map("routine_entries")
}

model Link {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  url         String
  title       String
  description String?
  area        String?
  isFavorite  Boolean  @default(false) @map("is_favorite")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "links_user_created_at_idx")
  @@map("links")
}

model TimeEntry {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  taskId          String?    @map("task_id") @db.Uuid
  northItemId     String?    @map("north_item_id") @db.Uuid
  description     String?
  area            Area?
  startedAt       DateTime   @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?  @map("ended_at") @db.Timestamptz(6)
  durationMinutes Int?       @map("duration_minutes")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  northItem       NorthItem? @relation(fields: [northItemId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt(sort: Desc)], map: "time_entries_user_started_at_idx")
  @@index([taskId], map: "time_entries_task_id_idx")
  @@index([northItemId], map: "time_entries_north_item_id_idx")
  @@map("time_entries")
}

model NorthTrack {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  title       String
  description String?
  area        Area?
  status      NorthTrackStatus @default(ACTIVE)
  startedAt   DateTime?        @map("started_at") @db.Timestamptz(6)
  targetDate  DateTime?        @map("target_date") @db.Date
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       NorthItem[]

  @@index([userId, status], map: "north_tracks_user_status_idx")
  @@map("north_tracks")
}

model NorthItem {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackId        String          @map("track_id") @db.Uuid
  title          String
  description    String?
  status         NorthItemStatus @default(TODO)
  position       Int
  plannedMinutes Int?            @map("planned_minutes")
  scheduledDate  DateTime?       @map("scheduled_date") @db.Date
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  track          NorthTrack      @relation(fields: [trackId], references: [id], onDelete: Cascade)
  timeEntries    TimeEntry[]

  @@index([trackId, position], map: "north_items_track_position_idx")
  @@index([trackId, status], map: "north_items_track_status_idx")
  @@index([scheduledDate], map: "north_items_scheduled_date_idx")
  @@map("north_items")
}
